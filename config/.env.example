# ===== QQ 开放平台机器人凭据（q.qq.com → 管理后台 → 开发设置）=====
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=

# ===== 点名系统（南大表格 SeaTable 外部应用）=====
# 默认已指向「【班长】宿舍晚点名情况查看」应用，无需修改
ROLLCALL_API_URL=https://table.nju.edu.cn/api/v2.1/universal-apps/1dbf1104-04c6-40ea-8325-efd0db0fc712/rows/
ROLLCALL_PAGE_ID=XY1Z
# 访问令牌（JWT，有效期约 3 天），获取与续期方法见 docs/rollcall_api.md
ROLLCALL_API_TOKEN=

# 说明：本文件仅为模板。本地参考时可复制为 .env（已被 .gitignore 排除）；
# 线上部署时将变量配置到 腾讯云 SCF → 函数配置 → 环境变量，严禁把真实凭据提交进仓库。
